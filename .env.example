# Copy this file to .env and fill in your values
# Never commit .env to version control

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SENDER_EMAIL=you@gmail.com
# Generate at: Google Account → Security → App Passwords
SENDER_APP_PASSWORD=your_app_password_here
GOODNOTES_EMAIL=your_goodnotes_import_email@example.com
GRADER_API_KEY=your_api_key
GRADER_BASE_URL=your image model or https://dashscope.aliyuncs.com/compatible-mode/v1
GRADER_MODEL=your model name or qwen3-vl-flash
